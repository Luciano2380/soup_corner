# Telegram — token fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=seu-token-do-botfather

# Google Maps Platform — chave com a Routes API habilitada
GOOGLE_MAPS_API_KEY=sua-chave-google-maps
SOURCE_ADDRESS=Rua do Restaurante, 123
STATE_CITY=Cidade Exemplo, Estado Exemplo

# LLM — Ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_EMBEDDING=nomic-embed-text

# Cardápio e prompts dos agentes
PDF_PATH=resources/pdf/soup_corner.pdf
AGENT_PATH=resources/prompts/principal_agent.md
ADDRESS_EXTRACTION_AGENT_PATH=resources/prompts/address_extraction_agent.md

# Painel de pedidos: modelo e pasta onde o painel do dia é gerado
HTML_TABLE_ORI_PATH=resources/html/index.html
HTML_TABLE_DEST_PATH=data/pages/

# Observabilidade
LOG_LEVEL=INFO
